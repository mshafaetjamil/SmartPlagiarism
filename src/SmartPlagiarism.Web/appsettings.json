{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Properties": {
      "Application": "SmartPlagiarism"
    }
  },
  "LogFile": {
    "Path": "App_Data/logs/smartplagiarism-.json",
    "RetainedFileCount": 30
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Api": {
    "UploadsPerMinute": 10
  },
  "Reports": {
    "InstitutionName": "Smart Plagiarism Detection System"
  },
  "Ocr": {
    "Enabled": true,
    "TessDataPath": "App_Data/tessdata",
    "Language": "ben+eng"
  }
}
