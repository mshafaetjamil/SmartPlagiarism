{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Api": {
    "UploadsPerMinute": 10
  },
  "Reports": {
    "InstitutionName": "Smart Plagiarism Detection System"
  },
  "Ocr": {
    "Enabled": true,
    "TessDataPath": "App_Data/tessdata",
    "Language": "ben+eng"
  }
}
