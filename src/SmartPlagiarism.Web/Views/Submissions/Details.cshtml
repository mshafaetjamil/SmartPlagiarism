@using System.Globalization
@using SmartPlagiarism.Core.Enums
@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Core.DTOs.Submissions.SubmissionDetailDto
@{
    ViewData["Title"] = Model.Title;

    string Dash(decimal percent) => Math.Clamp(percent, 0m, 100m).ToString("0.##", CultureInfo.InvariantCulture);
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index">My submissions</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <partial name="_StatusMessage" />

    <header class="report-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <div class="report-label">Originality report</div>
            <h1 class="report-title">@Model.Title</h1>
            <div class="text-body-secondary mb-2">
                @Model.CourseCode @Model.CourseTitle &middot; @Model.SemesterName &middot; @Model.Type
                &middot; Submitted @StatusBadge.ShortDate(Model.SubmittedAtUtc)
            </div>
            @StatusBadge.Status(Model.AnalysisStatus, Model.Status)
        </div>
        @if (Model.AnalysisStatus is AnalysisStatus.Completed or AnalysisStatus.Failed)
        {
            <a class="btn btn-report" asp-action="Report" asp-route-id="@Model.Id">Download report (PDF)</a>
        }
    </header>

    @if (Model.Result is { } result)
    {
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h2 class="report-card-title mb-3">Overall similarity</h2>
                        <svg class="report-gauge @StatusBadge.SimilarityTextClass(result.OverallSimilarityPercent)" viewBox="0 0 36 36"
                             role="img" aria-label="Overall similarity @StatusBadge.FormatPercent(result.OverallSimilarityPercent)">
                            <circle class="report-gauge-track" cx="18" cy="18" r="15.5" />
                            <circle class="report-gauge-value" cx="18" cy="18" r="15.5" pathLength="100"
                                    stroke-dasharray="@Dash(result.OverallSimilarityPercent) 100" transform="rotate(-90 18 18)" />
                            <text class="report-gauge-number" x="18" y="18" text-anchor="middle" dominant-baseline="central">@StatusBadge.FormatPercent(result.OverallSimilarityPercent)</text>
                        </svg>
                        <div class="report-band @StatusBadge.SimilarityTextClass(result.OverallSimilarityPercent)">@StatusBadge.SimilarityBandLabel(result.OverallSimilarityPercent)</div>
                        <p class="small text-body-secondary mt-2 mb-0">
                            How much of your work was also found in other documents.
                            @if (Model.Status == SubmissionStatus.PendingReview)
                            {
                                <span>Your course teacher will review it.</span>
                            }
                        </p>
                        @if (result.CommonTextPercent > 0)
                        {
                            <p class="small text-body-secondary mt-2 mb-0">
                                A further @StatusBadge.FormatPercent(result.CommonTextPercent) is text most of the course shares - a cover page,
                                a declaration - and is not counted.
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-body pb-0 flex-grow-0">
                        <h2 class="report-card-title mb-0">Matched sources</h2>
                    </div>
                    @if (Model.Sources.Count == 0)
                    {
                        <div class="card-body empty-state">Your work shares no text with any other document.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Source</th>
                                        <th scope="col" class="text-end">Passages</th>
                                        <th scope="col" title="How much of your work lies in passages found in this source">Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var source in Model.Sources)
                                    {
                                        <tr>
                                            <td>
                                                @source.Label
                                                <span class="list-meta">In @source.OwnFileName</span>
                                            </td>
                                            @* A byte-for-byte copy matches as a whole file, with no passages to count. *@
                                            <td class="text-end">@(source.PassageCount == 0 ? "-" : source.PassageCount.ToString())</td>
                                            <td>
                                                @if (source.IsOwnEarlierWork)
                                                {
                                                    <span class="text-body-secondary">@StatusBadge.FormatPercent(source.SimilarityPercent)</span>
                                                }
                                                else
                                                {
                                                    @StatusBadge.SimilarityBar(source.SimilarityPercent)
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <h2 class="report-card-title">Overall similarity</h2>
                @switch (Model.AnalysisStatus)
                {
                    case AnalysisStatus.Queued:
                        <p class="text-body-secondary mb-0">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Analysis pending &mdash; this submission is waiting in the queue.
                        </p>
                        break;
                    case AnalysisStatus.Processing:
                        <p class="text-body-secondary mb-0">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Analysis in progress.
                        </p>
                        break;
                    case AnalysisStatus.Failed:
                        <p class="text-danger mb-1">Analysis failed.</p>
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisError))
                        {
                            <p class="small mb-1">@Model.AnalysisError</p>
                        }
                        <p class="text-body-secondary small mb-0">Your teacher can re-run it.</p>
                        break;
                    default:
                        <p class="text-body-secondary mb-0">Analysis pending.</p>
                        break;
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.TeacherComment))
    {
        <div class="card mt-3">
            <div class="card-body">
                <h2 class="report-card-title">Teacher comment</h2>
                <p class="mb-0">@Model.TeacherComment</p>
            </div>
        </div>
    }

    <div class="card mt-3">
        <div class="card-body pb-0">
            <h2 class="report-card-title mb-0">Files examined</h2>
        </div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Size</th>
                        <th scope="col">Read by</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in Model.Files)
                    {
                        <tr>
                            <td title="SHA-256: @file.Sha256Hash">@file.OriginalFileName</td>
                            <td>@System.IO.Path.GetExtension(file.OriginalFileName).TrimStart('.').ToUpperInvariant()</td>
                            <td class="text-end text-nowrap">@StatusBadge.FormatBytes(file.SizeBytes)</td>
                            <td>@StatusBadge.Label(file.ReadBy)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Result is { } analysed)
        {
            <div class="card-body pt-2 small text-body-secondary">
                Analysed @StatusBadge.FullTime(analysed.AnalyzedAtUtc) by engine @analysed.EngineVersion.
            </div>
        }
    </div>

    @{
        var poller = AnalysisPollerViewModel.For(
            Url.Action(nameof(SubmissionsController.Status), "Submissions")!,
            [(Model.Id, Model.AnalysisStatus)]);
    }
    <partial name="_AnalysisPoller" model="poller" />
</div>
