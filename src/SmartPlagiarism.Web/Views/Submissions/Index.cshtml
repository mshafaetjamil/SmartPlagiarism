@model IReadOnlyList<SmartPlagiarism.Core.DTOs.Submissions.SubmissionListItemDto>
@{
    ViewData["Title"] = "My submissions";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="h3 mb-0">My submissions</h1>
        <a class="btn btn-primary" asp-action="Create">New submission</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success" role="alert">@statusMessage</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <p class="text-body-secondary mb-3">You have not submitted anything yet.</p>
                <a class="btn btn-primary" asp-action="Create">Create your first submission</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Course</th>
                            <th scope="col">Semester</th>
                            <th scope="col">Type</th>
                            <th scope="col">Files</th>
                            <th scope="col">Submitted</th>
                            <th scope="col">Analysis</th>
                            <th scope="col">Review</th>
                            <th scope="col" class="text-end">Similarity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@submission.Id">@submission.Title</a>
                                </td>
                                <td>@submission.CourseCode</td>
                                <td>@submission.SemesterName</td>
                                <td>@submission.Type</td>
                                <td>@submission.FileCount</td>
                                <td>@submission.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td>
                                    <span class="badge @StatusBadge.For(submission.AnalysisStatus)">
                                        @submission.AnalysisStatus
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @StatusBadge.For(submission.Status)">
                                        @StatusBadge.Label(submission.Status)
                                    </span>
                                </td>
                                <td class="text-end">
                                    @(submission.OverallSimilarityPercent.HasValue
                                        ? $"{submission.OverallSimilarityPercent.Value:0.00}%"
                                        : "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
