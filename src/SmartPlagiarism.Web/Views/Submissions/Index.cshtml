@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Core.DTOs.PagedResult<SmartPlagiarism.Core.DTOs.Submissions.SubmissionListItemDto>
@{
    ViewData["Title"] = "My submissions";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="h3 mb-0">My submissions</h1>
        <a class="btn btn-primary" asp-action="Create">New submission</a>
    </div>

    <partial name="_StatusMessage" />

    @if (Model.TotalCount == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body empty-state">
                <p class="mb-3">You have not submitted anything yet.</p>
                <a class="btn btn-primary" asp-action="Create">Create your first submission</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Submission</th>
                            <th scope="col">Submitted</th>
                            <th scope="col">Similarity</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model.Items)
                        {
                            <tr>
                                <td>
                                    <a class="list-title" asp-action="Details" asp-route-id="@submission.Id">@submission.Title</a>
                                    <span class="list-meta">
                                        @submission.CourseCode &middot; @submission.SemesterName &middot; @submission.Type &middot; @submission.FileCount file(s)
                                    </span>
                                </td>
                                <td class="text-nowrap" title="@StatusBadge.FullTime(submission.SubmittedAtUtc)">@StatusBadge.ShortDate(submission.SubmittedAtUtc)</td>
                                <td>@StatusBadge.SimilarityBar(submission.OverallSimilarityPercent)</td>
                                <td>@StatusBadge.Status(submission.AnalysisStatus, submission.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        var poller = AnalysisPollerViewModel.For(
            Url.Action(nameof(SubmissionsController.Status), "Submissions")!,
            Model.Items.Select(submission => (submission.Id, submission.AnalysisStatus)));

        <partial name="_Pager" model="PagerViewModel.For(nameof(SubmissionsController.Index), Model)" />
        <partial name="_AnalysisPoller" model="poller" />
    }
</div>
