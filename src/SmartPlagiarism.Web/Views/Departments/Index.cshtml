@model SmartPlagiarism.Core.DTOs.PagedResult<SmartPlagiarism.Core.DTOs.Admin.DepartmentDto>
@{
    ViewData["Title"] = "Departments";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h1 class="h3 mb-0">Departments</h1>
        <a class="btn btn-primary" asp-action="Create">New department</a>
    </div>

    <partial name="_StatusMessage" />

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Name</th>
                        <th scope="col" class="text-end">Courses</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var department in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@department.Code</td>
                            <td>@department.Name</td>
                            <td class="text-end">@department.CourseCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@department.Id">Edit</a>
                                <form method="post" asp-action="Delete" asp-route-id="@department.Id" class="d-inline"
                                      data-confirm="Delete department @department.Code?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pager" model="PagerViewModel.For(nameof(DepartmentsController.Index), Model)" />
</div>
