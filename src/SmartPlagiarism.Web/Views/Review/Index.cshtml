@using SmartPlagiarism.Core.DTOs.Review
@using SmartPlagiarism.Core.Enums
@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Web.Models.Review.ReviewListViewModel
@{
    ViewData["Title"] = "Submissions";
    var filter = Model.Filter;
    var results = Model.Results;

    // This filter form is checked on the server only - the page loads no
    // client-side validation script. With client validation on, an empty
    // validation summary still renders a hidden list item for that script to
    // fill, styled display:none inline, which the Content-Security-Policy refuses.
    ViewContext.ClientValidationEnabled = false;

    string SortIndicator(ReviewSortField field) =>
        filter.Sort != field ? string.Empty : filter.Desc ? " ▾" : " ▴";

    string? AriaSort(ReviewSortField field) =>
        filter.Sort != field ? null : filter.Desc ? "descending" : "ascending";

    (ReviewSortField Field, string Label)[] sortOptions =
    [
        (ReviewSortField.SubmittedAt, "Date submitted"),
        (ReviewSortField.Similarity, "Similarity"),
        (ReviewSortField.Title, "Title"),
        (ReviewSortField.Student, "Student"),
        (ReviewSortField.Course, "Course"),
    ];
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h1 class="h3 mb-0">Submissions</h1>
        <span class="text-body-secondary small">@results.TotalCount submission(s)</span>
    </div>

    <form method="get" asp-action="Index" class="card mb-3">
        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-warning small"></div>
            <div class="row g-2 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label small mb-1" for="CourseId">Course</label>
                    <select id="CourseId" name="CourseId" class="form-select form-select-sm">
                        <option value="">All courses</option>
                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.Id" selected="@(filter.CourseId == course.Id)">@course.Code</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label small mb-1" for="SemesterId">Semester</label>
                    <select id="SemesterId" name="SemesterId" class="form-select form-select-sm">
                        <option value="">All semesters</option>
                        @foreach (var semester in Model.Semesters)
                        {
                            <option value="@semester.Id" selected="@(filter.SemesterId == semester.Id)">@semester.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label small mb-1" for="Status">Review</label>
                    <select id="Status" name="Status" class="form-select form-select-sm">
                        <option value="">Any</option>
                        @foreach (var status in Enum.GetValues<SubmissionStatus>())
                        {
                            <option value="@status" selected="@(filter.Status == status)">@StatusBadge.Label(status)</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label small mb-1" for="Analysis">Analysis</label>
                    <select id="Analysis" name="Analysis" class="form-select form-select-sm">
                        <option value="">Any</option>
                        @foreach (var status in Enum.GetValues<AnalysisStatus>())
                        {
                            <option value="@status" selected="@(filter.Analysis == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-1">
                    <label class="form-label small mb-1" for="MinSimilarity">Min %</label>
                    <input id="MinSimilarity" name="MinSimilarity" type="number" min="0" max="100" step="1"
                           value="@filter.MinSimilarity" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-lg-1">
                    <label class="form-label small mb-1" for="MaxSimilarity">Max %</label>
                    <input id="MaxSimilarity" name="MaxSimilarity" type="number" min="0" max="100" step="1"
                           value="@filter.MaxSimilarity" class="form-control form-control-sm" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label small mb-1" for="Sort">Sort by</label>
                    <select id="Sort" name="Sort" class="form-select form-select-sm">
                        @foreach (var option in sortOptions)
                        {
                            <option value="@option.Field" selected="@(filter.Sort == option.Field)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label small mb-1" for="Desc">Order</label>
                    <select id="Desc" name="Desc" class="form-select form-select-sm">
                        <option value="true" selected="@filter.Desc">Highest or newest first</option>
                        <option value="false" selected="@(!filter.Desc)">Lowest or oldest first</option>
                    </select>
                </div>
                <div class="col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </div>
        </div>
    </form>

    @if (results.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body empty-state">No submissions match these filters.</div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@AriaSort(ReviewSortField.Title)">
                                <a asp-action="Index" asp-all-route-data="filter.RouteValues(sort: ReviewSortField.Title)">Submission@(SortIndicator(ReviewSortField.Title))</a>
                            </th>
                            <th scope="col" aria-sort="@AriaSort(ReviewSortField.Course)">
                                <a asp-action="Index" asp-all-route-data="filter.RouteValues(sort: ReviewSortField.Course)">Course@(SortIndicator(ReviewSortField.Course))</a>
                            </th>
                            <th scope="col" aria-sort="@AriaSort(ReviewSortField.Similarity)">
                                <a asp-action="Index" asp-all-route-data="filter.RouteValues(sort: ReviewSortField.Similarity)">Similarity@(SortIndicator(ReviewSortField.Similarity))</a>
                            </th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in results.Items)
                        {
                            <tr>
                                <td>
                                    <a class="list-title" asp-action="Submission" asp-route-id="@submission.Id">@submission.Title</a>
                                    <span class="list-meta" title="@StatusBadge.FullTime(submission.SubmittedAtUtc)">
                                        @submission.StudentName &middot; @submission.StudentNumber &middot; @StatusBadge.ShortDate(submission.SubmittedAtUtc)
                                    </span>
                                    @if (submission.MatchCount > 0)
                                    {
                                        <span class="list-meta">@submission.MatchCount matched source(s)</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @submission.CourseCode
                                    <span class="list-meta">@submission.SemesterName</span>
                                </td>
                                <td>@StatusBadge.SimilarityBar(submission.OverallSimilarityPercent)</td>
                                <td>@StatusBadge.Status(submission.AnalysisStatus, submission.Status)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Submission" asp-route-id="@submission.Id">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <partial name="_Pager" model="new PagerViewModel(nameof(ReviewController.Index), results.Page, results.TotalPages, page => filter.RouteValues(page: page))" />

        var poller = AnalysisPollerViewModel.For(
            Url.Action(nameof(AnalysisController.Status), "Analysis")!,
            results.Items.Select(submission => (submission.Id, submission.AnalysisStatus)));

        <partial name="_AnalysisPoller" model="poller" />
    }
</div>
