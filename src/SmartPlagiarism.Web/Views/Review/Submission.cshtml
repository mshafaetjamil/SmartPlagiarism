@using SmartPlagiarism.Core.Entities
@using SmartPlagiarism.Core.Enums
@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Core.DTOs.Review.ReviewSubmissionDetailDto
@{
    ViewData["Title"] = Model.Title;
    var canRerun = Model.AnalysisStatus is AnalysisStatus.Completed or AnalysisStatus.Failed;
    var thisPage = Url.Action(nameof(ReviewController.Submission), new { id = Model.Id });
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index">Submissions</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <partial name="_StatusMessage" />

    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0 me-2">@Model.Title</h1>
        <span class="badge @StatusBadge.For(Model.AnalysisStatus)">@Model.AnalysisStatus</span>
        <span class="badge @StatusBadge.For(Model.Status)">@StatusBadge.Label(Model.Status)</span>
        <div class="ms-auto d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" asp-action="Report" asp-route-id="@Model.Id">Download report (PDF)</a>
            @if (canRerun)
            {
                <form method="post" asp-controller="Analysis" asp-action="Rerun" asp-route-id="@Model.Id"
                      asp-route-returnUrl="@thisPage">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Re-run analysis</button>
                </form>
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-transparent"><h2 class="h6 mb-0">Details</h2></div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-5">Student</dt>
                        <dd class="col-7">@Model.StudentName <span class="d-block text-body-secondary">@Model.StudentNumber</span></dd>

                        <dt class="col-5">Course</dt>
                        <dd class="col-7">@Model.CourseCode &ndash; @Model.CourseTitle</dd>

                        <dt class="col-5">Semester</dt>
                        <dd class="col-7">@Model.SemesterName</dd>

                        <dt class="col-5">Type</dt>
                        <dd class="col-7">@Model.Type</dd>

                        <dt class="col-5">Submitted</dt>
                        <dd class="col-7">@Model.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-transparent"><h2 class="h6 mb-0">Originality analysis</h2></div>
                <div class="card-body">
                    @if (Model.Result is { } result)
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="stat-tile-value @StatusBadge.SimilarityTextClass(result.OverallSimilarityPercent)">
                                @StatusBadge.FormatPercent(result.OverallSimilarityPercent)
                            </span>
                            <span class="text-body-secondary">overall similarity &middot; @StatusBadge.SimilarityBandLabel(result.OverallSimilarityPercent)</span>
                        </div>
                        <div class="stat-bar mb-3" aria-hidden="true">
                            <div class="stat-bar-fill @StatusBadge.SimilarityBarClass(result.OverallSimilarityPercent)" data-bar-width="@result.OverallSimilarityPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"></div>
                        </div>
                        @if (result.CommonTextPercent > 0)
                        {
                            <p class="small text-body-secondary mb-1">
                                A further @result.CommonTextPercent.ToString("0.00")% is text most of the course shares - a cover page,
                                a declaration - and is not counted.
                            </p>
                        }
                        <p class="text-body-secondary small mb-0">
                            Analysed @result.AnalyzedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC by engine @result.EngineVersion.
                        </p>
                    }
                    else if (Model.AnalysisStatus == AnalysisStatus.Failed)
                    {
                        <p class="text-danger mb-1">Analysis failed.</p>
                        <p class="small mb-0">@Model.AnalysisError</p>
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Analysis @(Model.AnalysisStatus == AnalysisStatus.Processing ? "in progress" : "waiting in the queue").
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Result is { } analysed)
    {
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-transparent"><h2 class="h6 mb-0">Matched documents</h2></div>
            @if (analysed.Matches.Count == 0)
            {
                <div class="card-body empty-state">No other submission shares text with this one.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Matched source</th>
                                <th scope="col">Written by</th>
                                <th scope="col">Files</th>
                                <th scope="col" class="text-end">Passages</th>
                                <th scope="col" title="How much of this submission lies in passages found in that source">Share of submission</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var match in analysed.Matches)
                            {
                                <tr>
                                    <td>
                                        @if (match.ArchiveYear is not null)
                                        {
                                            <span class="badge text-bg-dark me-1">Archive @match.ArchiveYear</span>@match.SourceTitle
                                        }
                                        else if (match.CanOpenSource && match.MatchedSubmissionId is { } matchedId)
                                        {
                                            <a asp-action="Submission" asp-route-id="@matchedId">@match.SourceTitle</a>
                                        }
                                        else
                                        {
                                            <span title="A submission in another department">@match.SourceTitle</span>
                                        }
                                    </td>
                                    <td>
                                        @match.SourceOwner
                                        @if (match.IsOwnEarlierWork)
                                        {
                                            <span class="badge text-bg-secondary ms-1" title="The student's own earlier submission: listed, but not counted in the overall figure">Own earlier work &middot; not counted</span>
                                        }
                                    </td>
                                    <td class="small">
                                        @match.OwnFileName
                                        <span class="text-body-secondary">&harr;</span>
                                        @match.MatchedFileName
                                    </td>
                                    <td class="text-end">@match.PassageCount</td>
                                    <td>@StatusBadge.SimilarityBar(match.SimilarityPercent)</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-primary" asp-action="Compare" asp-route-id="@match.MatchId">Compare</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (Model.MatchedBy.Count > 0)
    {
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-transparent">
                <h2 class="h6 mb-0">Later submissions that contain text from this one</h2>
                <p class="small text-body-secondary mb-0">
                    Each submission is compared only with work that existed before it, so these are not in the score
                    above. The share is how much of the later submission was found here.
                </p>
            </div>
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Later submission</th>
                            <th scope="col">Written by</th>
                            <th scope="col">Submitted</th>
                            <th scope="col">Share of it</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var later in Model.MatchedBy)
                        {
                            <tr>
                                <td>
                                    @if (later.CanOpen)
                                    {
                                        <a asp-action="Submission" asp-route-id="@later.SubmissionId">@later.SubmissionTitle</a>
                                    }
                                    else
                                    {
                                        <span title="A submission in another department">@later.SubmissionTitle</span>
                                    }
                                </td>
                                <td>
                                    @later.StudentName
                                    @if (later.IsSameStudent)
                                    {
                                        <span class="badge text-bg-secondary ms-1">Same student</span>
                                    }
                                </td>
                                <td class="small">@later.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td>@StatusBadge.SimilarityBar(later.SimilarityPercent)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Compare" asp-route-id="@later.MatchId">Compare</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-transparent"><h2 class="h6 mb-0">Files</h2></div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col" class="text-end">Size</th>
                        <th scope="col">Read by</th>
                        <th scope="col" class="text-end">Words</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in Model.Files)
                    {
                        <tr>
                            <td>
                                @file.OriginalFileName
                                <span class="d-block small text-body-secondary">@file.ContentType</span>
                            </td>
                            <td class="text-end">@StatusBadge.FormatBytes(file.SizeBytes)</td>
                            <td>@StatusBadge.Label(file.ExtractionMethod)</td>
                            <td class="text-end">@(file.WordCount?.ToString("N0") ?? "-")</td>
                        </tr>
                        @if (file.Warnings.Count > 0)
                        {
                            <tr class="table-warning">
                                <td colspan="4" class="small">
                                    <ul class="mb-0 ps-3">
                                        @foreach (var warning in file.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-transparent"><h2 class="h6 mb-0">Review</h2></div>
        <div class="card-body">
            @if (Model.Status != SubmissionStatus.PendingReview)
            {
                <p class="mb-1">
                    <span class="badge @StatusBadge.For(Model.Status)">@StatusBadge.Label(Model.Status)</span>
                </p>
                @if (!string.IsNullOrWhiteSpace(Model.TeacherComment))
                {
                    <p class="mb-0">@Model.TeacherComment</p>
                }
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                            <label for="approve-comment" class="form-label small">Comment (optional)</label>
                            <textarea id="approve-comment" name="Comment" rows="3" class="form-control mb-2"
                                      maxlength="@Submission.MaxTeacherCommentLength"></textarea>
                            <button type="submit" class="btn btn-success">Approve</button>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <form method="post" asp-action="Reject" asp-route-id="@Model.Id">
                            <label for="reject-comment" class="form-label small">Reason (required)</label>
                            <textarea id="reject-comment" name="Comment" rows="3" class="form-control mb-2" required
                                      maxlength="@Submission.MaxTeacherCommentLength"></textarea>
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    @{
        var poller = AnalysisPollerViewModel.For(
            Url.Action(nameof(AnalysisController.Status), "Analysis")!,
            [(Model.Id, Model.AnalysisStatus)]);
    }
    <partial name="_AnalysisPoller" model="poller" />
</div>
