@{
    ViewData["Title"] = "Access denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <h1 class="h3 mb-3">Access denied</h1>
            <p class="text-body-secondary mb-4">
                Your account does not have permission to view that page. If you believe
                this is a mistake, contact an administrator.
            </p>
            <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Back to my dashboard</a>
        </div>
    </div>
</div>
