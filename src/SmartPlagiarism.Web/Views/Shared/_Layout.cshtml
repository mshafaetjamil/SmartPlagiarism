@{
    var signedIn = User.Identity?.IsAuthenticated == true;

    // The sign-in page draws its own split screen across the whole window.
    var showPageFrame = ViewData["HidePageFrame"] is not true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &ndash; SmartPlagiarism</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="app-shell">
        @if (showPageFrame && signedIn)
        {
            <partial name="_Sidebar" />
        }

        <div class="app-main">
            @if (showPageFrame && !signedIn)
            {
                <partial name="_TopBar" />
            }

            <main role="main" class="flex-grow-1">
                @RenderBody()
            </main>

            @if (showPageFrame)
            {
                <footer class="app-footer py-3 mt-auto">
                    <div class="container">
                        <span>&copy; @DateTime.UtcNow.Year SmartPlagiarism</span>
                    </div>
                </footer>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
