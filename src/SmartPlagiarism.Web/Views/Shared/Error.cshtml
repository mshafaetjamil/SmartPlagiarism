@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5 mw-640">
    <p class="text-body-secondary small text-uppercase mb-1">Error @Model.StatusCode</p>
    <h1 class="h3 mb-3">@Model.Title</h1>
    <p class="mb-4">@Model.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary">
            Reference: <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex flex-wrap gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Go to my dashboard</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
        }
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Home page</a>
    </div>
</div>
