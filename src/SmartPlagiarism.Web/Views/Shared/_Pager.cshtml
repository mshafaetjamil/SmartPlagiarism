@model SmartPlagiarism.Web.Models.PagerViewModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.RouteFor(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.RouteFor(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
