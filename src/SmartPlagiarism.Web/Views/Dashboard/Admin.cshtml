@model SmartPlagiarism.Core.DTOs.Dashboards.AdminDashboardDto
@{
    ViewData["Title"] = "Admin dashboard";

    string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double size = bytes;
        var unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }

    StatTileViewModel[] tiles =
    [
        new("Users", Model.TotalUsers.ToString()),
        new("Submissions", Model.TotalSubmissions.ToString()),
        new("Stored files", Model.TotalUploadedFiles.ToString(), FormatBytes(Model.TotalStoredBytes)),
        StatTileViewModel.Similarity("Average similarity", Model.AverageSimilarityPercent),
    ];

    var largestRole = Model.UsersByRole.Count == 0 ? 0 : Model.UsersByRole.Max(role => role.UserCount);
    var largestStatus = Model.SubmissionsByAnalysisStatus.Count == 0 ? 0 : Model.SubmissionsByAnalysisStatus.Max(status => status.Count);
}

<div class="container py-4">
    <h1 class="h3 mb-4">Admin dashboard</h1>

    <div class="row g-3 mb-3">
        @foreach (var tile in tiles)
        {
            <div class="col-6 col-lg-3">
                <partial name="_StatTile" model="tile" />
            </div>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h2 class="h6 mb-0">Users by role</h2>
                </div>
                <table class="table mb-0 align-middle">
                    <tbody>
                        @foreach (var roleCount in Model.UsersByRole)
                        {
                            <tr>
                                <td class="col-w-6">@roleCount.Role</td>
                                <td><div class="stat-bar" aria-hidden="true"><div class="stat-bar-fill bg-primary" data-bar-width="@StatusBadge.BarWidth(roleCount.UserCount, largestRole)"></div></div></td>
                                <td class="text-end fw-semibold col-w-4">@roleCount.UserCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h2 class="h6 mb-0">Submissions by analysis status</h2>
                </div>
                <table class="table mb-0 align-middle">
                    <tbody>
                        @foreach (var statusCount in Model.SubmissionsByAnalysisStatus)
                        {
                            <tr>
                                <td class="col-w-6"><span class="badge @StatusBadge.For(statusCount.Status)">@statusCount.Status</span></td>
                                <td><div class="stat-bar" aria-hidden="true"><div class="stat-bar-fill bg-primary" data-bar-width="@StatusBadge.BarWidth(statusCount.Count, largestStatus)"></div></div></td>
                                <td class="text-end fw-semibold col-w-4">@statusCount.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
