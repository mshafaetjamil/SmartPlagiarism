@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Core.DTOs.Dashboards.StudentDashboardDto
@{
    ViewData["Title"] = "My dashboard";

    StatTileViewModel[] tiles =
    [
        new("Submissions", Model.TotalSubmissions.ToString()),
        new("Being analysed", Model.AwaitingAnalysis.ToString()),
        new("Awaiting review", Model.PendingReview.ToString()),
        new("Approved", Model.Approved.ToString()),
    ];
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="h3 mb-0">My dashboard</h1>
        <a class="btn btn-primary" asp-controller="Submissions" asp-action="Create">New submission</a>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var tile in tiles)
        {
            <div class="col-6 col-lg-3">
                <partial name="_StatTile" model="tile" />
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Latest submissions</h2>
                <a class="small" asp-controller="Submissions" asp-action="Index">All my submissions &rarr;</a>
            </div>
        </div>
        @if (Model.LatestSubmissions.Count == 0)
        {
            <div class="card-body empty-state">
                You have not submitted anything yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Submission</th>
                            <th scope="col">Similarity</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model.LatestSubmissions)
                        {
                            <tr>
                                <td>
                                    <a class="list-title" asp-controller="Submissions" asp-action="Details" asp-route-id="@submission.SubmissionId">@submission.Title</a>
                                    <span class="list-meta" title="@StatusBadge.FullTime(submission.SubmittedAtUtc)">
                                        @submission.CourseCode &middot; @StatusBadge.ShortDate(submission.SubmittedAtUtc)
                                    </span>
                                </td>
                                <td>@StatusBadge.SimilarityBar(submission.OverallSimilarityPercent)</td>
                                <td>@StatusBadge.Status(submission.AnalysisStatus, submission.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            var poller = AnalysisPollerViewModel.For(
                Url.Action(nameof(SubmissionsController.Status), "Submissions")!,
                Model.LatestSubmissions.Select(submission => (submission.SubmissionId, submission.AnalysisStatus)));

            <partial name="_AnalysisPoller" model="poller" />
        }
    </div>
</div>
