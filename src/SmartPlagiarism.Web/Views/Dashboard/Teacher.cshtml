@using SmartPlagiarism.Core.Enums
@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Core.DTOs.Dashboards.TeacherDashboardDto
@{
    ViewData["Title"] = "Teacher dashboard";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Teacher dashboard</h1>

    <partial name="_StatusMessage" />

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-body-secondary small text-uppercase">Pending review</div>
                    <div class="display-6">@Model.PendingReviewCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-body-secondary small text-uppercase">Analysed submissions</div>
                    <div class="display-6">@Model.AnalyzedSubmissionCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-body-secondary small text-uppercase">Average similarity</div>
                    <div class="display-6">
                        @(Model.AverageSimilarityPercent.HasValue
                            ? $"{Model.AverageSimilarityPercent.Value:0.00}%"
                            : "-")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Recent submissions</h2>
                <a class="small" asp-controller="Review" asp-action="Index">All submissions &rarr;</a>
            </div>
        </div>
        @if (Model.RecentSubmissions.Count == 0)
        {
            <div class="card-body text-body-secondary">
                No submissions have been made yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Student</th>
                            <th scope="col">Course</th>
                            <th scope="col">Submitted</th>
                            <th scope="col">Analysis</th>
                            <th scope="col">Review</th>
                            <th scope="col" class="text-end">Similarity</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model.RecentSubmissions)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Review" asp-action="Submission" asp-route-id="@submission.SubmissionId">@submission.Title</a>
                                </td>
                                <td>
                                    @submission.StudentName
                                    <span class="text-body-secondary small d-block">@submission.StudentNumber</span>
                                </td>
                                <td>@submission.CourseCode</td>
                                <td>@submission.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td>
                                    <span class="badge @StatusBadge.For(submission.AnalysisStatus)"
                                          title="@submission.AnalysisError">@submission.AnalysisStatus</span>
                                    @if (!string.IsNullOrWhiteSpace(submission.AnalysisError))
                                    {
                                        <span class="d-block small text-danger">@submission.AnalysisError</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @StatusBadge.For(submission.Status)">@StatusBadge.Label(submission.Status)</span>
                                </td>
                                <td class="text-end">
                                    @StatusBadge.Similarity(submission.OverallSimilarityPercent)
                                </td>
                                <td class="text-end">
                                    @if (submission.AnalysisStatus is AnalysisStatus.Completed or AnalysisStatus.Failed)
                                    {
                                        <form method="post" asp-controller="Analysis" asp-action="Rerun"
                                              asp-route-id="@submission.SubmissionId" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Re-run analysis</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            var poller = AnalysisPollerViewModel.For(
                Url.Action(nameof(AnalysisController.Status), "Analysis")!,
                Model.RecentSubmissions.Select(submission => (submission.SubmissionId, submission.AnalysisStatus)));

            <partial name="_AnalysisPoller" model="poller" />
        }
    </div>
</div>
