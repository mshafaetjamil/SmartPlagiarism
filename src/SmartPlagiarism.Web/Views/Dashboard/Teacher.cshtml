@using SmartPlagiarism.Core.Enums
@using SmartPlagiarism.Web.Models.Analysis
@model SmartPlagiarism.Core.DTOs.Dashboards.TeacherDashboardDto
@{
    ViewData["Title"] = "Teacher dashboard";

    StatTileViewModel[] tiles =
    [
        new("Pending review", Model.PendingReviewCount.ToString()),
        new("Analysed submissions", Model.AnalyzedSubmissionCount.ToString()),
        StatTileViewModel.Similarity("Average similarity", Model.AverageSimilarityPercent),
    ];
}

<div class="container py-4">
    <h1 class="h3 mb-4">Teacher dashboard</h1>

    <partial name="_StatusMessage" />

    <div class="row g-3 mb-3">
        @foreach (var tile in tiles)
        {
            <div class="col-md-4">
                <partial name="_StatTile" model="tile" />
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Recent submissions</h2>
                <a class="small" asp-controller="Review" asp-action="Index">All submissions &rarr;</a>
            </div>
        </div>
        @if (Model.RecentSubmissions.Count == 0)
        {
            <div class="card-body empty-state">
                No submissions have been made yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Submission</th>
                            <th scope="col">Course</th>
                            <th scope="col">Similarity</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model.RecentSubmissions)
                        {
                            <tr>
                                <td>
                                    <a class="list-title" asp-controller="Review" asp-action="Submission" asp-route-id="@submission.SubmissionId">@submission.Title</a>
                                    <span class="list-meta" title="@StatusBadge.FullTime(submission.SubmittedAtUtc)">
                                        @submission.StudentName &middot; @submission.StudentNumber &middot; @StatusBadge.ShortDate(submission.SubmittedAtUtc)
                                    </span>
                                </td>
                                <td>@submission.CourseCode</td>
                                <td>@StatusBadge.SimilarityBar(submission.OverallSimilarityPercent)</td>
                                <td>
                                    @StatusBadge.Status(submission.AnalysisStatus, submission.Status)
                                    @if (!string.IsNullOrWhiteSpace(submission.AnalysisError))
                                    {
                                        <span class="d-block small text-danger">@submission.AnalysisError</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Review" asp-action="Submission" asp-route-id="@submission.SubmissionId">Review</a>
                                    @if (submission.AnalysisStatus is AnalysisStatus.Completed or AnalysisStatus.Failed)
                                    {
                                        <form method="post" asp-controller="Analysis" asp-action="Rerun"
                                              asp-route-id="@submission.SubmissionId" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Re-run analysis</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            var poller = AnalysisPollerViewModel.For(
                Url.Action(nameof(AnalysisController.Status), "Analysis")!,
                Model.RecentSubmissions.Select(submission => (submission.SubmissionId, submission.AnalysisStatus)));

            <partial name="_AnalysisPoller" model="poller" />
        }
    </div>
</div>
