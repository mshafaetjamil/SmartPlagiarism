<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SmartPlagiarism.Web</RootNamespace>
    <UserSecretsId>ad284a53-f90e-4c49-b96f-41ed8222b1cf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPlagiarism.Core\SmartPlagiarism.Core.csproj" />
    <ProjectReference Include="..\SmartPlagiarism.Infrastructure\SmartPlagiarism.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Design-time only. Required because Web is the startup project for the
      `dotnet ef` commands documented in CLAUDE.md; it is not shipped at runtime.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi pulls in, which
      NuGet audit flags with a high-severity vulnerability (NU1903).
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
