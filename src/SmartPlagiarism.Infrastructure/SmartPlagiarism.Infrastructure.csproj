<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartPlagiarism.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPlagiarism.Core\SmartPlagiarism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Needed for AddIdentity + the Identity cookie handler, which live in the
      ASP.NET Core shared framework rather than in a NuGet package. CLAUDE.md
      puts "Identity setup" in Infrastructure, so the reference belongs here.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />

    <!--
      Not used directly. Microsoft.Data.SqlClient 6.1.1 (under EF Core's SQL Server
      provider) brings in 9.0.4, which has known vulnerabilities
      (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pinned here, the patched version
      also reaches Web and the tests through their reference to this project.
      Remove once SqlClient depends on a fixed version itself.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Noto Sans Bengali (SIL OFL 1.1, licence alongside) is embedded so reports
      render Bangla identically on every server, fonts installed or not.
    -->
    <EmbeddedResource Include="Reports\Fonts\*.ttf" />
  </ItemGroup>

</Project>
