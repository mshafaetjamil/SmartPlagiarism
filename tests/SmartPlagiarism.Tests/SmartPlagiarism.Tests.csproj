<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartPlagiarism.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!--
      Pinned to 7.x: FluentAssertions 8.0 moved to the Xceed licence, which requires
      a paid key for commercial use. 7.2.0 is the last Apache-2.0 release and is
      API-compatible with everything this project needs.
    -->
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!--
      Pinned above the 2.1.11 that EF Core's SQLite provider pulls in, which carries
      a high-severity advisory (GHSA-2m69-gcr7-jv3q). Remove once EF depends on a
      fixed version itself.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Real documents that cannot be built programmatically: a Bangla PDF's damage
      comes from the shaping engine that produced it, which PdfPig's builder does
      not reproduce.
    -->
    <None Include="Extraction\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartPlagiarism.Core\SmartPlagiarism.Core.csproj" />
    <ProjectReference Include="..\..\src\SmartPlagiarism.Engine\SmartPlagiarism.Engine.csproj" />
    <ProjectReference Include="..\..\src\SmartPlagiarism.Infrastructure\SmartPlagiarism.Infrastructure.csproj" />
  </ItemGroup>

</Project>
